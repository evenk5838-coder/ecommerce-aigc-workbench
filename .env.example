# 服务
APP_HOST=127.0.0.1
APP_PORT=8100
APP_CONCURRENCY=1
APP_MAX_UPLOAD_MB=20

# 云端推理（火山方舟 Ark）
# 1) 把 Key 填在本机 .env 的 ARK_API_KEY（不要提交、不要发到对话里）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 2) 预算（元）。默认 0 = 禁止调用任何付费接口；批准后填写，例如 20
APP_BUDGET_CNY=0

# 导演对话的技术上限；不代表获得新增付费调用授权
DIRECTOR_MAX_OUTPUT_TOKENS=1600
DIRECTOR_MAX_ROUNDS=4
DIRECTOR_MAX_TOOL_CALLS=4
DIRECTOR_MAX_REPEATED_ERRORS=2
DIRECTOR_MAX_COST_PER_CALL_CNY=0.05
DIRECTOR_MAX_SESSION_COST_CNY=0.30
